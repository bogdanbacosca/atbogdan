# Resend API key — https://resend.com/api-keys
# NOTE: the previous key leaked in git history — rotate it in the Resend
# dashboard and update this value + the Vercel env var when you do.
RESEND_API_KEY=KEY
# Sender address. Must be a domain verified in Resend. Without a verified
# domain, Resend only allows the shared test sender "onboarding@resend.dev",
# which delivers ONLY to the email address that owns the Resend account.
# Domain atbogdan.ro is verified in Resend — any local part on it works.
CONTACT_FROM_EMAIL=contact@atbogdan.ro

# Recipient(s) of the contact-form notifications AND of emails forwarded from
# contact@atbogdan.ro (comma-separated).
CONTACT_TO_EMAIL=bogdanbacosca@gmail.com

# Resend webhook signing secret — Resend → Webhooks → your webhook → Signing
# Secret (starts with "whsec_"). Required by /api/webhooks/resend to verify the
# Svix signature on every delivery. Until it is set, the endpoint answers 500.
# Add the same value to the Vercel project environment variables.
RESEND_WEBHOOK_SECRET=